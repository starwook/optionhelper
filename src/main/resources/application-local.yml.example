# 이 파일을 application-local.yml 로 복사한 뒤 값을 채운다. application-local.yml 은 git에 올라가지 않는다.
spring:
  datasource:
    username: root
    password: change-me

optionhelper:
  earnings:
    source: alphavantage
    alpha-vantage:
      api-key: your-alpha-vantage-key
  # 앱 공용 Claude API 키(경제지표 속보 등). 없으면 속보 기능만 꺼진다
  antropic:
    api-key: your-anthropic-api-key
